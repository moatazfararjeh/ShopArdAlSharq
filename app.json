{
  "expo": {
    "name": "FoodBox",
    "slug": "ardalsharq",
    "version": "1.9.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ardalsharq",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ardalsharq.foodbox",
      "buildNumber": "45",
      "infoPlist": {
        "NSFaceIDUsageDescription": "السماح لتطبيق أرض الشرق باستخدام Face ID لتسجيل الدخول",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar",
        "UISemanticContentAttribute": "forceRightToLeft"
      },
      "runtimeVersion": "1.1.0"
    },
    "android": {
      "package": "com.ardalsharq.app",
      "versionCode": 16,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "runtimeVersion": "1.1.0"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "السماح لتطبيق أرض الشرق باستخدام Face ID لتسجيل الدخول"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e36523",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "ArdAlsharq",
          "mode": "production"
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "السماح لتطبيق أرض الشرق باستخدام موقعك لتحديد عنوان التوصيل على الخريطة"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "930260f4-2f52-4396-8533-c61ceb68bd72"
      }
    },
    "owner": "malfararjeh",
    "updates": {
      "url": "https://u.expo.dev/930260f4-2f52-4396-8533-c61ceb68bd72"
    }
  }
}
